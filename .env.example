# アプリケーション設定
APP_ENV=development  # development, test, production
APP_PORT=8080

# PostgreSQL設定
DB_HOST=localhost
DB_PORT=5432
DB_NAME=voro
DB_USER=voro_user
DB_PASSWORD=voro_password

# テスト用PostgreSQL設定
TEST_DB_NAME=voro_test
TEST_DB_USER=voro_test_user
TEST_DB_PASSWORD=voro_test_password

# Redis設定
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
TEST_REDIS_DB=1

# セッション設定
SESSION_TTL=604800  # 7日間（秒）

# ログ設定
LOG_LEVEL=info  # debug, info, warn, error
LOG_FILE=var/log/voro.log

# データベース接続設定
DB_MAX_RETRIES=3  # 最大リトライ回数（0-10、本番推奨: 5）
DB_INITIAL_RETRY_DELAY=1  # 初期リトライ間隔（秒）
DB_MAX_RETRY_DELAY=30  # 最大リトライ間隔（秒）
DB_HEALTH_CHECK_ENABLED=false  # ヘルスチェック有効化（本番推奨: true）

# Redis接続設定
REDIS_MAX_RETRIES=3  # 最大リトライ回数（0-10、本番推奨: 5）
REDIS_INITIAL_RETRY_DELAY=1  # 初期リトライ間隔（秒）
REDIS_MAX_RETRY_DELAY=30  # 最大リトライ間隔（秒）
REDIS_HEALTH_CHECK_ENABLED=false  # ヘルスチェック有効化（本番推奨: true）

# S3設定（オプション - 将来の画像アップロード機能用）
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key
# S3_BUCKET_NAME=voro-uploads
# S3_REGION=ap-northeast-1
